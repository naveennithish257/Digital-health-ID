# ============================================================
# MEDVAULT DIGITAL HEALTH ID SYSTEM — ENVIRONMENT CONFIGURATION
# Production & Free-Tier Stack Configuration v2.0
# ============================================================

# ── 1. Application Settings ───────────────────────────────────
NODE_ENV=development
PORT=3000
# Base public URL where the frontend/API is hosted (used to generate emergency QR code URLs)
FRONTEND_URL=http://localhost:3000

# ── 2. Database Configuration (MySQL / TiDB / Aiven / PlanetScale)
DB_HOST=localhost
DB_PORT=3306
DB_USER=healthid_user
DB_PASSWORD=your_secure_password_here
DB_NAME=health_id_system
# Set to 'true' if using managed cloud MySQL (e.g., TiDB Serverless, Aiven, PlanetScale)
DB_SSL=false

# ── 3. JWT Authentication & Token Security ────────────────────
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" to generate
JWT_SECRET=medvault-super-secure-jwt-secret-key-2026-production
JWT_REFRESH_SECRET=medvault-refresh-token-secret-key-2026-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── 4. Cloudinary (Free Object Storage for Medical Records & PDFs)
# Free 25 GB storage & bandwidth with zero credit card required
# Sign up and grab keys from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── 5. Resend (Free Transactional Email & OTP Notifications) ───
# Free tier gives 3,000 emails/month (100 emails/day)
# Sign up and generate API key: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Use onboarding@resend.dev until your custom domain is verified in Resend
EMAIL_FROM=MedVault <onboarding@resend.dev>

# ── 6. Email OTP Delivery (MSG91 Email API Primary + Resend Fallback) ──
# Primary: MSG91 Email Service (delivers OTP directly to patient mail ID)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_EMAIL_TEMPLATE_ID=your_msg91_template_id
MSG91_EMAIL_FROM=support@medvault.health
MSG91_EMAIL_DOMAIN=medvault.health
MSG91_FLOW_ID=your_msg91_flow_id
MSG91_SENDER_ID=smsind

# Provider 2: Twilio (Alternative global SMS provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# NOTE: If both MSG91 and Twilio keys are left empty, the server automatically
# operates in Development Mode and logs the 6-digit OTP directly to the terminal.

# ── 7. Google Gemini AI (Health Records Assistant) ─────────────
# Free tier API key (up to 15 RPM / 1M TPM free)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── 8. Groq AI (High-Speed LLM Fallback) ──────────────────────
# Ultra-fast LLM fallback (openai/gpt-oss-120b, 20b)
# Get your free API key at: https://console.groq.com/keys
Groq_API_KEY=your_groq_api_key_here

# ── 9. Admin Portal Credentials ───────────────────────────────
# Default credentials to access the Security & Doctor Verification Dashboard (/admin)
ADMIN_EMAIL=admin@medvault.health
ADMIN_PASSWORD=Admin@MedVault2026!

# ── 9. Redis Cache & Session Store (Optional) ──────────────────
# Leave blank for in-memory store; or connect Upstash / local Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── 10. National Health Network & ABDM Integration (Sandbox) ──
# Ayushman Bharat Digital Mission (ABDM) sandbox endpoints
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_API_URL=https://healthidsbx.abdm.gov.in
UIDAI_AADHAAR_API_URL=https://api.uidai.gov.in

# ── 11. Security, Rate Limiting & Upload Policy ───────────────
# Rate limit window in milliseconds (default: 1 hour)
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=20

# Max document upload size in MB (Cloudinary free tier supports up to 10MB per file)
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# ── 12. Monitoring & Error Tracking (Optional) ─────────────────
# Free tier Sentry for real-time error telemetry
SENTRY_DSN=

# ── 13. System Feature Flags ──────────────────────────────────
ENABLE_EMERGENCY_QR=true
ENABLE_AI_ASSISTANT=true
ENABLE_PATIENT_CONSENT=true
ENABLE_DOCTOR_VERIFICATION=true
ENABLE_AUDIT_LOGGING=true

# ── 14. Compliance & Retention ────────────────────────────────
DATA_RETENTION_YEARS=7
ENABLE_GDPR_FEATURES=true
ENABLE_HIPAA_FEATURES=true
